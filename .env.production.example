# Copy this file to .env on the server. Never commit the server's real .env.
DOMAIN=tukiva.example.com
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-different-long-random-password

# Optional: keep the default unless you have a reason to change it.
POSTGRES_PUBLISHED_PORT=5433
DEPLOYMENT_DURATION_MINUTES=30
DEPLOYMENT_TUNNEL_ENABLED=true
