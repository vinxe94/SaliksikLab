{
  "version": 1,
  "frontend": {
    "path": "frontend",
    "output": "dist",
    "build_script": "build"
  },
  "backend": {
    "path": "backend",
    "runtime": "python",
    "entrypoint": "manage.py",
    "settings_module": "sample.settings",
    "health_path": "/api/health/",
    "migrate": true
  },
  "database": {
    "engine": "sqlite",
    "persist": true
  },
  "api_prefixes": [
    "/api"
  ]
}
