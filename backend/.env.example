SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok.app,.ngrok-free.dev,.ngrok.dev,.ngrok.io,.trycloudflare.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.ngrok-free\.app$,^https://.*\.ngrok\.app$,^https://.*\.ngrok-free\.dev$,^https://.*\.ngrok\.dev$,^https://.*\.ngrok\.io$,^https://.*\.trycloudflare\.com$
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.app,https://*.ngrok-free.dev,https://*.ngrok.dev,https://*.ngrok.io,https://*.trycloudflare.com

# PostgreSQL
DB_NAME=thesis_repo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Translation provider

# Temporary hosting: run `python manage.py hosting_worker` alongside Django.
DEPLOYMENT_DURATION_MINUTES=30
MAX_UPLOAD_SIZE_MB=200
# Student PDF/ZIP attachments stay outside public MEDIA_ROOT until approval.
# SUBMISSION_STORAGE_PATH=/srv/tukiva/private_submissions
# Default: backend/storage/deployments (must be outside MEDIA_ROOT)
# DEPLOYMENT_STORAGE_PATH=/srv/tukiva/deployments
DEPLOYMENT_INTERNAL_PORT=8080
DEPLOYMENT_MEMORY_LIMIT=512m
DEPLOYMENT_CPU_LIMIT=0.5
DEPLOYMENT_PIDS_LIMIT=128
DEPLOYMENT_BUILD_TIMEOUT_SECONDS=600
HEALTHCHECK_TIMEOUT_SECONDS=60
DEPLOYMENT_HEALTHCHECK_FAILURES=3
DEPLOYMENT_HEALTHCHECK_PATH=/
DEPLOYMENT_RUBY_IMAGE=ruby:3.4-bookworm
DEPLOYMENT_CPP_IMAGE=gcc:14-trixie
DEPLOYMENT_FULLSTACK_PYTHON_IMAGE=tukiva-hosting-python:3.12
# Python deployments also use this prepared image by default. To override:
# DEPLOYMENT_PYTHON_IMAGE=your-prepared-python-image:tag
DEPLOYMENT_POSTGRESQL_IMAGE=postgres:17-bookworm
DEPLOYMENT_MYSQL_IMAGE=mysql:8.4
DEPLOYMENT_DATABASE_TIMEOUT_SECONDS=120
DEPLOYMENT_CLEANUP_INTERVAL=1
# Each execution gets a public https://<random>.trycloudflare.com URL.
# No Cloudflare account, API token, or custom domain is required.
DEPLOYMENT_TUNNEL_ENABLED=true
# Must point to this application's Django backend on the Docker host.
DEPLOYMENT_TUNNEL_ORIGIN=http://127.0.0.1:8080
DEPLOYMENT_TUNNEL_TIMEOUT_SECONDS=180
DEPLOYMENT_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.3
# Optional local/custom-domain mode when DEPLOYMENT_TUNNEL_ENABLED=false:
DEPLOYMENT_BASE_DOMAIN=
DEPLOYMENT_PUBLIC_SCHEME=https
# Optional absolute origin for /temp/<deployment_id>/ links when frontend/API differ.
DEPLOYMENT_PUBLIC_ORIGIN=
# Fullstack previews require a separate host for frontend/API routing and cookies.
# This default works locally with Django listening on port 8080.
# Remote visitors use Cloudflare URLs by default. With tunnels disabled,
# configure DEPLOYMENT_BASE_DOMAIN with wildcard DNS/TLS for remote visitors.
DEPLOYMENT_FULLSTACK_BASE_DOMAIN=preview.localhost:8080
DEPLOYMENT_FULLSTACK_PUBLIC_SCHEME=http
